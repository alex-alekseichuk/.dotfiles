#!/usr/bin/bash
umask 077
echo -n 'Password: '
read -s password

vim -n -c "setlocal nobackup nowritebackup noswapfile noeol nofixeol" \
    -c "silent %!openssl enc -aes-256-cbc -pbkdf2 -iter 100000 -pass fd:3 3<<<"$password" -d 2>/dev/null" \
    -c "autocmd BufWritePre <buffer> silent %!openssl enc -aes-256-cbc -pbkdf2 -iter 100000 -pass fd:3 3<<<"$password" 2>/dev/null" \
    -c "autocmd BufWritePost <buffer> silent %!openssl enc -aes-256-cbc -pbkdf2 -iter 100000 -pass fd:3 3<<<"$password" -d 2>/dev/null" \
    "$1"

